# development | staging | production — required production settings enforced when set to production
ENVIRONMENT=development

# Database - use PostgreSQL for production
# SQLite (development): sqlite:///./dev.db
#
# Supabase (Transaction pooler, IPv4 — Dashboard → Connect → Transaction pooler):
#   postgresql+psycopg2://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
# Use +psycopg2 (this app) and ?sslmode=require. Replace <DB_PASSWORD> with Database password from Settings → Database.
DATABASE_URL=sqlite:///./dev.db

# CORS - comma-separated allowed origins
# Add your production domain, e.g. https://iskonnect.ph
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT secret - generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# JWT: short-lived access token + rotating refresh token (stored hashed in DB)
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=14
# Auth API: POST /api/v1/auth/refresh, /api/v1/auth/logout, /auth/forgot-password, /auth/reset-password, /auth/verify-email

# Production default is AUTH_DISABLED=false (JWT required). Use true only for special local debugging.
AUTH_DISABLED=false

# Run Alembic on API startup (local dev only). Production: use release command / manual alembic upgrade head
RUN_MIGRATIONS_ON_STARTUP=false

# Required in production: shared rate limits, email abuse caps, scholarship cache across workers
# REDIS_URL=redis://localhost:6379/0

# Gunicorn workers (production Procfile); default 2
# WEB_CONCURRENCY=2

# Set true in production behind Render/Railway so rate limits use real client IPs
# TRUST_PROXY_HEADERS=true

# Sentry - set SENTRY_DSN to enable error tracking (get from sentry.io)
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Feature flags (optional)
# FILTER_EXPIRED_FROM_MATCHES defaults to true (exclude expired/broken_link from matching)
# FILTER_EXPIRED_FROM_MATCHES=false
# STRUCTURED_LOGGING=true  # recommended in production (JSON logs)
# PORT=8000  # Hugging Face Spaces sets PORT=7860; Dockerfile uses ${PORT:-8000}
# ENABLE_LINK_CHECKER=false in dev (no outbound HEAD checks). Set true in production — see .github/workflows/link-checker.yml
# ENABLE_LINK_CHECKER=true
# Default in app code is false. Set true in production for in-app match/deadline alerts (no SMTP required).
# ENABLE_NOTIFICATIONS=true
ENABLE_NOTIFICATIONS=false
# DB_DRIVEN_WEIGHTS=false
# RETENTION_INACTIVE_DAYS=365

# Email (SMTP) — required in production only when REQUIRE_EMAIL_VERIFICATION=true
# Beta on Render: set REQUIRE_EMAIL_VERIFICATION=false (no verified sender needed yet)
# Public launch: REQUIRE_EMAIL_VERIFICATION=true + SMTP_* + EMAIL_FROM + FRONTEND_URL
# REQUIRE_EMAIL_VERIFICATION=false
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
# EMAIL_FROM=noreply@iskonnect.ph
# FRONTEND_URL=http://localhost:5173

# PostgreSQL connection pool (multi-worker API)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10

# Supabase Storage (admin scholarship image uploads — optional until enabled)
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SCHOLARSHIP_IMAGE_BUCKET=scholarship-images
# SCHOLARSHIP_IMAGE_MAX_BYTES=5242880
