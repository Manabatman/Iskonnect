# Vite reads only variables prefixed with VITE_.
# Local API (default in src/api/client.ts is also http://localhost:8000).
VITE_API_BASE_URL=http://localhost:8000

# Optional: Sentry error tracking for the frontend (get DSN from sentry.io)
# VITE_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# VITE_SENTRY_ENVIRONMENT=production
# VITE_SENTRY_RELEASE=git-sha-or-version

# Cloudflare Turnstile site key (public — pairs with TURNSTILE_SECRET_KEY on the API)
# VITE_TURNSTILE_SITE_KEY=
