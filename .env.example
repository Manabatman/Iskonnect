# Database - use PostgreSQL for production
# SQLite (development): sqlite:///./dev.db
# PostgreSQL: postgresql://user:password@host:5432/dbname
# Note: For PostgreSQL, install psycopg2-binary
DATABASE_URL=sqlite:///./dev.db

# CORS - comma-separated allowed origins
# Add your production domain, e.g. https://iskonnect.ph
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT secret - generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# Optional: JWT algorithm and token expiry
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=60

# Production default is AUTH_DISABLED=false (JWT required). For local development only:
AUTH_DISABLED=true

# Run Alembic on API startup (local dev only). Production: use release command / manual alembic upgrade head
RUN_MIGRATIONS_ON_STARTUP=true

# Optional: shared Redis for scholarship cache across workers (omit for single-worker)
# REDIS_URL=redis://localhost:6379/0

# Sentry - set SENTRY_DSN to enable error tracking (get from sentry.io)
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Feature flags (optional; defaults are safe/off)
# FILTER_EXPIRED_FROM_MATCHES=false
# STRUCTURED_LOGGING=false
# ENABLE_LINK_CHECKER=false
# Set true in production/staging to enable in-app notifications (match + deadline).
ENABLE_NOTIFICATIONS=true
# DB_DRIVEN_WEIGHTS=false
# RETENTION_INACTIVE_DAYS=365
